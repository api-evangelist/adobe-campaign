  "item": [
    {
      "id": "c99b7881-1215-4cb3-9e64-39efa31dd1f0",
      "name": "Query Definition",
      "description": {
        "content": "Execute queries against Campaign schemas using the xtk:queryDef interface. Supports get, getIfExists, select, and count operations with XPath field expressions, WHERE conditions, and pagination.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8bf7d8f3-fd9e-4f8d-8f43-9ccd90a6a0cf",
          "name": "Adobe Campaign Execute a Query",
          "request": {
            "name": "Adobe Campaign Execute a Query",
            "description": {
              "content": "Executes a query against a Campaign schema using the xtk:queryDef interface. Supports operations: get (single record, error if missing), getIfExists (single record, null if missing), select (multiple records with pagination), and count (record count). Uses XPath expressions for field selection and WHERE conditions. SOAP Action: xtk:queryDef#ExecuteQuery",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "xtk-queryDef",
                "ExecuteQuery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "SOAPAction",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "text/xml"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Security-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <queryDef>\n    <schema>(string)</schema>\n    <operation>(string)</operation>\n    <lineCount>(integer)</lineCount>\n    <startLine>(integer)</startLine>\n    <select>\n    </select>\n    <where>\n    </where>\n    <orderBy>\n    </orderBy>\n  </queryDef>\n</element>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
