      },
      "item": [
        {
          "id": "697a8006-cb28-4afe-84ab-a359b43148d1",
          "name": "Adobe Campaign Push a Real-time Transactional Event",
          "request": {
            "name": "Adobe Campaign Push a Real-time Transactional Event",
            "description": {
              "content": "Pushes a single real-time event to the Message Center execution instance for transactional message processing. The event must include the event type and recipient context data. Supports email, SMS, and push notification channels. SOAP Action: nms:rtEvent#PushEvent",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "nms-rtEvent",
                "PushEvent"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "SOAPAction",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "text/xml"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Security-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <rtEvent>\n    <type>(string)</type>\n    <email>(string)</email>\n    <origin>(string)</origin>\n    <wishedChannel>(integer)</wishedChannel>\n    <externalId>(string)</externalId>\n    <mobilePhone>(string)</mobilePhone>\n    <scheduled>(string)</scheduled>\n    <ctx>\n    </ctx>\n  </rtEvent>\n</element>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
