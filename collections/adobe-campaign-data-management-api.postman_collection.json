      "id": "ee080f79-52b0-4ee1-9473-941694d27be5",
      "name": "Data Management",
      "description": {
        "content": "Write, update, and delete data records using the xtk:session#Write method. Supports insert, insertOrUpdate, update, and delete operations via the _operation attribute.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "bf9ac7a7-11b8-4384-971e-9309a14ebd00",
          "name": "Adobe Campaign Write Data Records",
          "request": {
            "name": "Adobe Campaign Write Data Records",
            "description": {
              "content": "Writes data records to a Campaign schema. The _operation attribute on the entity element controls the behavior: insert (create new), insertOrUpdate (create or update if exists), update (modify existing), delete (remove record). SOAP Action: xtk:session#Write",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "xtk-session",
                "Write"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "SOAPAction",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "text/xml"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Security-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <entity>\n    <_operation>(string)</_operation>\n    <_schema>(string)</_schema>\n  </entity>\n</element>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
