                "description": "The unique PKEY identifier of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partially updates a subscription service with the provided attributes."
        },
        {
          "info": {
            "name": "Adobe Campaign Delete a Service",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
