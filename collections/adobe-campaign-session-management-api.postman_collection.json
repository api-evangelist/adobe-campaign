                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) ",
                    "key": "SOAPAction",
                    "value": "example_value"
                  },
                  {
                    "key": "Accept",
                    "value": "text/xml"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <strLogin>example_value</strLogin>\n  <strPassword>example_value</strPassword>\n</soapenv:Envelope>",
                  "options": {
                    "raw": {
                      "language": "xml"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/xml"
                }
              ],
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <sessionToken>example_value</sessionToken>\n  <securityToken>example_value</securityToken>\n  <sessionInfo>\n    <serverInfo>(string)</serverInfo>\n    <timezone>(string)</timezone>\n  </sessionInfo>\n</element>",
              "cookie": [],
