                      "item": [
                        {
                          "name": "Adobe Campaign Authenticate and Create a Session",
                          "id": "4919c0b4-e2ec-49ac-ab4b-9fe4b5aecd75",
                          "protocolProfileBehavior": {
                            "disableBodyPruning": true
                          },
                          "request": {
                            "method": "POST",
                            "header": [
                              {
                                "description": "(Required) ",
                                "key": "SOAPAction",
                                "value": "<string>"
                              },
                              {
                                "key": "Content-Type",
                                "value": "text/xml"
                              },
                              {
                                "key": "Accept",
                                "value": "text/xml"
                              }
                            ],
                            "body": {
                              "mode": "raw",
                              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <strLogin>(string)</strLogin>\n  <strPassword>(string)</strPassword>\n</soapenv:Envelope>",
                              "options": {
                                "raw": {
                                  "headerFamily": "xml",
                                  "language": "xml"
                                }
                              }
                            },
                            "url": {
                              "raw": "{{baseUrl}}/nl/jsp/soaprouter.jsp/xtk-session/Logon",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "nl",
                                "jsp",
                                "soaprouter.jsp",
                                "xtk-session",
                                "Logon"
                              ]
                            },
                            "description": "Authenticates with username and password credentials and returns session and security tokens. These tokens must be passed as cookie (__sessiontoken) and header (X-Security-Token) on all subsequent requests. SOAP Action: xtk:session#Logon"
                          },
