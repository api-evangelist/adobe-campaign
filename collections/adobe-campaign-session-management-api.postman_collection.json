        {
          "id": "d8058439-f4a8-4d39-a6b7-270f876ec4e6",
          "name": "Adobe Campaign Terminate a Session",
          "request": {
            "name": "Adobe Campaign Terminate a Session",
            "description": {
              "content": "Invalidates the current session and security tokens. SOAP Action: xtk:session#Logout",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "xtk-session",
                "Logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
