  "item": [
    {
      "id": "61272427-b81d-42a0-b272-a88596e56255",
      "name": "Session Management",
      "description": {
        "content": "Authenticate and manage server sessions. Logon returns session and security tokens required for all subsequent API calls.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "82d198ac-3897-491d-a0ad-ec0069eece64",
          "name": "Adobe Campaign Authenticate and Create a Session",
          "request": {
            "name": "Adobe Campaign Authenticate and Create a Session",
            "description": {
              "content": "Authenticates with username and password credentials and returns session and security tokens. These tokens must be passed as cookie (__sessiontoken) and header (X-Security-Token) on all subsequent requests. SOAP Action: xtk:session#Logon",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "xtk-session",
                "Logon"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "SOAPAction",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "text/xml"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <strLogin>(string)</strLogin>\n  <strPassword>(string)</strPassword>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": [
            {
              "id": "ef2b5d3b-86c8-4109-8209-352d96e22538",
              "name": "Authentication successful. Returns session and security tokens.",
              "originalRequest": {
                "url": {
                  "path": [
                    "nl",
                    "jsp",
                    "soaprouter.jsp",
                    "xtk-session",
                    "Logon"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Campaign Classic instance name",
                      "type": "any",
                      "value": "{{instance}}",
                      "key": "instance"
                    }
