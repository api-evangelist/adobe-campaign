      "item": [
        {
          "id": "d012b87a-dcae-4fce-9d32-b785f4873c0c",
          "name": "Adobe Campaign Subscribe a Recipient to a Service",
          "request": {
            "name": "Adobe Campaign Subscribe a Recipient to a Service",
            "description": {
              "content": "Subscribes a recipient to an information service. Requires the service name and a recipient DOM element. SOAP Action: nms:subscription#Subscribe",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "nl",
                "jsp",
                "soaprouter.jsp",
                "nms-subscription",
                "Subscribe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "SOAPAction",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "text/xml"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Security-Token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <serviceName>(string)</serviceName>\n  <recipient>\n    <email>(string)</email>\n    <id>(integer)</id>\n  </recipient>\n  <create>(boolean)</create>\n</element>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": [
            {
              "id": "6ff5a309-9fac-4fdb-8009-83b0511893aa",
              "name": "Recipient subscribed successfully.",
