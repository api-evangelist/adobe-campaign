                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <serviceName>Example Campaign</serviceName>\n  <recipient>\n    <email>(string)</email>\n    <id>(integer)</id>\n  </recipient>\n  <create>true</create>\n</element>",
