              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "PKEY",
                  "description": "(Required) The unique PKEY identifier of the resource."
                },
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
