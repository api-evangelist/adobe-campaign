            {
              "name": "Adobe Campaign Trigger a Transactional Event",
              "id": "a5ded072-2c1b-41fc-b8f7-f8313a4af0c7",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"<email>\",\n  \"mobilePhone\": \"<string>\",\n  \"pushPlatform\": \"gcm\",\n  \"ctx\": {\n    \"id7\": \"anim velit d\"\n  },\n  \"scheduled\": \"<dateTime>\",\n  \"expiration\": \"<dateTime>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/:transactionalAPI/:eventID",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":transactionalAPI",
                    ":eventID"
                  ],
                  "variable": [
                    {
                      "id": "08d5bcce-73dd-42ba-ba5e-af822c8649ac",
                      "key": "transactionalAPI",
                      "value": "<string>",
                      "description": "(Required) The transactional API name corresponding to the event configuration (e.g., EVTorderConfirmation)."
                    },
                    {
                      "id": "07731d11-a21a-4853-b087-84576a37fc4f",
                      "key": "eventID",
                      "value": "<string>",
                      "description": "(Required) The unique event type identifier."
                    }
                  ]
                },
                "description": "Sends a transactional event to trigger a personalized message. The transactionalAPI path segment corresponds to the event configuration name. Events are processed asynchronously and support email, SMS, and push notification channels."
              },
