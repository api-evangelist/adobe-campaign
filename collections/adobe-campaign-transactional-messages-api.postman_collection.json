        {
          "id": "750aa5d4-080d-4164-87fb-bb24d381510c",
          "name": "Adobe Campaign Trigger a Transactional Event",
          "request": {
            "name": "Adobe Campaign Trigger a Transactional Event",
            "description": {
              "content": "Sends a transactional event to trigger a personalized message. The transactionalAPI path segment corresponds to the event configuration name. Events are processed asynchronously and support email, SMS, and push notification channels.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":transactionalAPI",
                ":eventID"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "transactionalAPI",
                  "description": "(Required) The transactional API name corresponding to the event configuration (e.g., EVTorderConfirmation)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "eventID",
                  "description": "(Required) The unique event type identifier."
                },
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"mobilePhone\": \"<string>\",\n  \"pushPlatform\": \"<string>\",\n  \"ctx\": {\n    \"key_0\": \"string\"\n  },\n  \"scheduled\": \"<dateTime>\",\n  \"expiration\": \"<dateTime>\"\n}",
