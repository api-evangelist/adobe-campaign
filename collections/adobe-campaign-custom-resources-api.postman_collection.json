    {
      "id": "9e735b0c-3b94-4e91-84b6-70b0f5d2b801",
      "name": "Custom Resources",
      "description": {
        "content": "Access custom resources defined in Campaign Standard, both profile-linked and standalone.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "470745c7-8123-4a05-8ea6-2394f44fa509",
          "name": "Adobe Campaign List Profile-linked Custom Resources",
          "request": {
            "name": "Adobe Campaign List Profile-linked Custom Resources",
            "description": {
              "content": "Retrieves records from a profile-linked custom resource. Custom resources are defined with the cus prefix in Campaign Standard.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profileAndServicesExt",
                ":cusResourceName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "_lineCount",
                  "value": "25",
                  "description": "Number of records to return per page. Default is 25."
                },
                {
                  "disabled": false,
                  "key": "_lineStart",
                  "value": "<integer>",
                  "description": "Pagination offset from the next node in previous response."
                },
                {
                  "disabled": false,
                  "key": "_order",
                  "value": "<string>",
                  "description": "Sort order. Use field name for ascending, append %20desc for descending (e.g., email%20desc)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "cusResourceName",
                  "description": "(Required) The name of the custom resource (with cus prefix, e.g., cusMyResource)."
                },
                {
                  "description": "Your Campaign Classic instance name",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
